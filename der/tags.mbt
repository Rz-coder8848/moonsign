///|
/// Universal-class tag numbers used by this project.
///
/// Values are the full identifier octet for the primitive/constructed form of
/// the tag (low-tag-number form only).
pub let tag_boolean : Int32 = 0x01

///|
pub let tag_integer : Int32 = 0x02

///|
pub let tag_bit_string : Int32 = 0x03

///|
pub let tag_octet_string : Int32 = 0x04

///|
pub let tag_null : Int32 = 0x05

///|
pub let tag_oid : Int32 = 0x06

///|
pub let tag_utf8_string : Int32 = 0x0C

///|
pub let tag_sequence : Int32 = 0x30

///|
pub let tag_set : Int32 = 0x31

///|
pub let tag_utc_time : Int32 = 0x17

///|
pub let tag_generalized_time : Int32 = 0x18
